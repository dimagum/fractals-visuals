{
  "name": "fractals-visuals",
  "private": true,
  "version": "0.1.0",
  "description": "Интерактивные карты самых известных фракталов на WebGL2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:gpu": "E2E_ANGLE=metal playwright test e2e/df64.spec.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimagum/fractals-visuals.git"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/sofia-sans-extra-condensed": "^5.3.0"
  }
}
